# CivicOS Global Environment Configuration Template
# Copy this file to .env before starting the development environment.

# -----------------------------------------------------------------------------
# Runtime & System Setup
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL Database Connection
# -----------------------------------------------------------------------------
POSTGRES_USER=civicos_admin
POSTGRES_PASSWORD=civicos_dev_password
POSTGRES_DB=civicos_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://civicos_admin:civicos_dev_password@localhost:5432/civicos_db

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_key_change_in_production_32bytes
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production_32bytes
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Seed Admin Credentials (dev only — change before production deploy)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@civicos.dev
SEED_ADMIN_PASSWORD=dev-admin-password-change-me
