# Production image — no watch mode, production-only dependencies.
# The dev image (Dockerfile) stays for docker compose up (ADR-017 bind mounts).
FROM oven/bun:latest

WORKDIR /app

ENV NODE_ENV=production

COPY package.json ./

RUN bun install --omit=dev

COPY src ./src

EXPOSE 3000

CMD ["bun", "src/index.ts"]
